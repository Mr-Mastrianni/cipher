{
  "name": "cipher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:engine": "node --import tsx --test \"src/lib/**/__tests__/*.test.ts\"",
    "test": "pnpm run test:engine",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --import tsx scripts/seed.mts",
    "geo:dots": "node --import tsx scripts/land-dots.mts",
    "db:studio": "drizzle-kit studio",
    "dev:world": "node server/world-server.mjs",
    "dev:realm": "concurrently -k -n web,world -c cyan,magenta \"next dev\" \"node server/world-server.mjs\"",
    "dev:realm:webpack": "concurrently -k -n web,world -c cyan,magenta \"next dev --webpack\" \"node server/world-server.mjs\"",
    "start:world": "node server/world-server.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.11",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/fiber": "^9.8.2",
    "astronomia": "^4.2.0",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.52.0",
    "luxon": "^3.7.2",
    "motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "simplex-noise": "^4.0.3",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2"
}
