# =============================================================================
# The Cipher — environment variables
# =============================================================================
# EVERY variable here is optional. With an empty environment the app still
# builds and runs: charts are computed, readings are shareable, and the whole
# product is explorable on the in-memory demo store. Each integration below
# unlocks a specific capability, and the UI degrades with an honest message
# rather than an error when its variable is absent.
# =============================================================================

# --- Core --------------------------------------------------------------------
# The public origin, used for absolute URLs in metadata, emails and Stripe
# redirects. In production this is your Vercel domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication (Clerk) --------------------------------------------------
# Without these, every auth surface renders a "not configured" notice and the
# app stays fully browsable. Create an application at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the Clerk webhook (Dashboard → Webhooks → Signing Secret).
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma-separated emails promoted to the admin role on sign-in (verified primary
# address only). Adding one promotes an account that already exists; removing
# one does not demote — change the role in the console for that.
ADMIN_EMAILS=

# --- Database (Neon Postgres) ------------------------------------------------
# When set, the Drizzle/Postgres store is used and data is durable. When unset,
# a seeded in-memory store is used so the deployed demo works end to end — but
# that store is per-instance and non-durable. Add the Neon integration in the
# Vercel dashboard, or paste a connection string from https://neon.tech
DATABASE_URL=

# --- Payments (Stripe) -------------------------------------------------------
# The base tier is $15/month (Initiate). Create the products and prices in
# Stripe, then paste the price IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INITIATE=
STRIPE_PRICE_ADEPT=
STRIPE_PRICE_ORACLE=

# --- Admin AI agent ----------------------------------------------------------
# The agent speaks the OpenAI-compatible Chat Completions protocol. DeepSeek is
# the default when its key is present; OpenAI is the fallback, so an existing
# deployment keeps working unchanged. Without any key the console still loads,
# lists its tools, and explains exactly what it would need to run.
#
# DeepSeek: https://api.deepseek.com, models deepseek-flash (V4.1-Flash) and
# deepseek-v4-pro. Both support tool calls. This key selects DeepSeek.
DEEPSEEK_API_KEY=
# Force a provider: "deepseek" or "openai". Otherwise inferred from the keys.
AGENT_PROVIDER=
# Overrides the model id. Defaults to deepseek-flash on DeepSeek, gpt-4o-mini on
# OpenAI. Use deepseek-v4-pro for the heavier reasoning model.
AGENT_MODEL=
# OpenAI key, used when no DeepSeek key is set. It is also the only key that can
# drive realtime voice and server-side transcription; a DeepSeek key cannot.
OPENAI_API_KEY=
# Overrides the base URL for either provider (a gateway, or a self-hosted
# compatible endpoint). Leave blank to use the provider's own URL.
OPENAI_BASE_URL=

# GitHub access for the agent's code tools. With a token and repo, the agent
# reads the site's code from GitHub (a Vercel deployment does not ship the
# source tree). Use a fine-grained token scoped to this one repository with
# "Contents" and "Pull requests" set to read and write.
GITHUB_TOKEN=
AGENT_GITHUB_REPO=owner/repo
AGENT_GITHUB_DEFAULT_BRANCH=main
# Set to true to let the agent open draft pull requests (each one still needs
# you to click Approve in the console). It never pushes to the default branch:
# merging the pull request is what deploys the change.
AGENT_ENABLE_WRITES=false
# Long random string that signs approval tokens, so an approval survives a
# serverless cold start. Generate one with: openssl rand -hex 32
AGENT_CONFIRMATION_SECRET=

# --- Optional integrations ---------------------------------------------------
# Realtime community chat. Without it the client falls back to polling.
ABLY_API_KEY=

# Live calls. Without it the calls page still schedules and RSVPs, but the
# join button explains that a provider is not configured.
DAILY_API_KEY=

# Email notifications.
RESEND_API_KEY=
EMAIL_FROM=

# Rate limiting for the public endpoints.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
